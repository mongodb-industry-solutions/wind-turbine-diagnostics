# Shared by api/ and frontend/
MONGODB_URI=
DATABASE_NAME=audio
APP_NAME=devrel-demo-vectorsearch-audio-turbine

# api/ only
# Device panns-inference loads the AudioTagging model on. Defaults to
# 'cpu' to match the CPU-only torch install in api/Dockerfile; only set
# to 'cuda' on a GPU-equipped host running its own torch+CUDA install.
TORCH_DEVICE=cpu
# Name of the MongoDB Vector Search index created by
# utils/indexes/create_vector_index.py
VECTOR_INDEX_NAME=vector_index

# frontend/ only
API_HOST=localhost
